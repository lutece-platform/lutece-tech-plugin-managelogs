<?xml version="1.0" encoding="UTF-8" standalone="no"?><plug-in>
    <name>managelogs</name>
    <class>fr.paris.lutece.portal.service.plugin.PluginDefaultImplementation</class>
    <version>2.0.0-SNAPSHOT</version>
    <documentation>https://github.com/lutece-platform/lutece-tech-plugin-managelogs</documentation>
    <installation>https://github.com/lutece-platform/lutece-tech-plugin-managelogs</installation>
    <changes>https://github.com/lutece-platform/lutece-tech-plugin-managelogs</changes>
    <user-guide>https://github.com/lutece-platform/lutece-tech-plugin-managelogs</user-guide>
    <description>managelogs.plugin.description</description>
    <provider>managelogs.plugin.provider</provider>
    <provider-url>http://lutece.paris.fr/</provider-url>
    <icon-url>images/admin/skin/feature_default_icon.png</icon-url>
    <copyright>Copyright (c) 2019 Mairie de Paris</copyright>
    <db-pool-required>0</db-pool-required>
    
    <core-version-dependency>
        <min-core-version>8.0.0</min-core-version>
        <max-core-version/>	
    </core-version-dependency>

    <!-- Admin features parameters -->
    <admin-features>
        <admin-feature>
            <feature-id>MANAGELOGS_MANAGEMENT</feature-id>
            <feature-title>managelogs.adminFeature.ManageLogsProperties.name</feature-title>
            <feature-description>managelogs.adminFeature.ManageLogsProperties.description</feature-description>
            <feature-level>0</feature-level>
            <feature-url>jsp/admin/plugins/managelogs/DownloadLog.jsp</feature-url>
            <icon-url>ti ti-file-download</icon-url>
      </admin-feature>
    </admin-features>

    <!-- XPages parameters -->
    <applications>
    </applications>

    <!-- Portlet parameters -->
    <portlets>
   </portlets>
</plug-in>